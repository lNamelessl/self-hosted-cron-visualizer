{
	admin off
	auto_https off
}

# Railway runtime-injects PORT (8080). No PORT variable is defined anywhere in the
# template — this placeholder reads it at startup, falling back to 8080 locally.
:{$PORT:8080}

encode zstd gzip

header {
	-Server
	-X-Powered-By
	X-Content-Type-Options "nosniff"
	X-Frame-Options "DENY"
	Referrer-Policy "no-referrer"
	Permissions-Policy "camera=(), microphone=(), geolocation=()"
	Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
}

route {
	handle /health {
		respond "ok" 200
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
